# Flutter/Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub-cache/
app/.pub/
app/build/
app/*.iml
app/*.ipr
app/*.iws
app/.idea/

# Android
app/android/.gradle/
app/android/captures/
app/android/local.properties
app/android/**/GeneratedPluginRegistrant.java
app/android/key.properties
app/android/app/*.jks

# iOS (kept out of scope but ignore if regenerated)
app/ios/Flutter/.last_build_id
app/ios/Pods/
app/ios/.symlinks/

# Coverage
app/coverage/

# macOS
.DS_Store

# Obsidian local config (keep vault content, ignore user-machine settings)
context/.obsidian/workspace*
context/.obsidian/plugins/
